NODE_ENV=development
PORT=8000

# --- PostgreSQL (Neon) ---
# Copy this straight from your Neon project's "Connection string" page.
# Keep ?sslmode=require at the end — Neon rejects unencrypted connections.
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Upstash Redis (REST API, not the raw TCP URL) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- JWT ---
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=30d

# --- Frontend (Next.js) ---
CLIENT_URL=http://localhost:3000

# --- Nodemailer / Brevo SMTP ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=ERP System
EMAIL_FROM_ADDRESS=no-reply@yourdomain.com
